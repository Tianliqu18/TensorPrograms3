        "a = rng.standard_normal((1, n)) * np.sqrt(sigma2_W_0 / n)\n",
        "x_1 = X[0]\n",
        "x_2 = X[1]\n",
        "\n",
        "g1_1 = x_1 @ W_0\n",
        "g1_2 = x_2 @ W_0\n",
        "h1_1 = np.maximum(0, g1_1)\n",
        "h1_2 = np.maximum(0, g1_2)\n",
        "\n",
        "g2_1 = (a @ h1_1).item()\n",
        "g2_2 = (a @ h1_2).item()\n",
        "y_1, y_2 = rng.standard_normal(2)\n",
        "h2_1 = y_1 - (1 / np.sqrt(d)) * g2_1\n",
        "h2_2 = y_2 - (1 / np.sqrt(d)) * g2_2\n",
        "h3_1 = (g1_1 > 0).astype(np.float64)\n",
        "h3_2 = (g1_2 > 0).astype(np.float64)\n",
        "h4_1 = (1 / np.sqrt(d)) * (a @ h3_1) * h3_1\n",
        "h4_2 = (1 / np.sqrt(d)) * (a @ h3_2) * h3_2\n",
        "g3_1 = (a @ h4_1).item()\n",
        "g3_2 = (a @ h4_2).item()\n",
        "g4_1 = (1 / np.sqrt(d)) * (x_1 @ h4_1)\n",
        "g4_2 = (1 / np.sqrt(d)) * (x_2 @ h4_2)\n",
        "h_vectors = [g1_1, g1_2, np.full(n, g2_1), np.full(n, g2_2), np.full(n, g3_1), np.full(n, g3_2), np.full(n, g4_1), np.full(n, g4_2)]\n",
        "\n",
        "B1 = np.eye(2)\n",
        "B2 = np.array([[1/2, 1/(2*np.pi)], [1/(2*np.pi), 1/2]])\n",
        "B3 = np.array([[1 + 1/d, 1/(2*d*np.pi)], [1/(2*d*np.pi), 1 + 1/d]])\n",
        "b4_diag = 1/2 + 5/(8*d) - 1/(4*d*np.pi)\n",
        "B4 = np.array([[b4_diag, 1/(2*d*np.pi)], [1/(2*d*np.pi), b4_diag]])\n",
        "Sigma = np.block([[B1, np.zeros((2,6))], [np.zeros((2,2)), B2, np.zeros((2,4))], [np.zeros((2,4)), B3, np.zeros((2,2))], [np.zeros((2,6)), B4]])\n",
